<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear4"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">
		<com.a525team.weekbrowser.SkinTextView
			android:id="@+id/siut"
			android:focusable="false"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text=" Search in URL (RegExp)"
			android:textSize="12sp"
			android:layout_weight="1" />
		<com.a525team.weekbrowser.SkinButton
			android:id="@+id/delete"
			android:layout_width="40dp"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text=""
			android:textSize="12sp"
			app:skinKey="rbg" />
	</LinearLayout>
	<com.a525team.weekbrowser.SkinTextView
		android:id="@+id/siu"
		android:focusable="false"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="TextView"
		android:textSize="12sp"
		app:skinKey="bbg" />
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:padding="8dp"
			android:orientation="vertical"
			android:layout_weight="1">
			<com.a525team.weekbrowser.SkinTextView
				android:id="@+id/ect"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text=" Error code"
				android:textSize="12sp" />
			<com.a525team.weekbrowser.SkinTextView
				android:id="@+id/ec"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="TextView"
				android:textSize="12sp"
				app:skinKey="bbg" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear3"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:padding="8dp"
			android:orientation="vertical"
			android:layout_weight="1">
			<com.a525team.weekbrowser.SkinTextView
				android:id="@+id/mtt"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text=" MIME type"
				android:textSize="12sp" />
			<com.a525team.weekbrowser.SkinTextView
				android:id="@+id/mt"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="TextView"
				android:textSize="12sp"
				app:skinKey="bbg" />
		</LinearLayout>
	</LinearLayout>
	<com.a525team.weekbrowser.SkinTextView
		android:id="@+id/rtt"
		android:focusable="false"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="Return content"
		android:textSize="12sp" />
	<com.a525team.weekbrowser.SkinTextView
		android:id="@+id/rt"
		android:focusable="false"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:text="TextView"
		android:textSize="12sp"
		app:skinKey="bbg" />
</LinearLayout>
